# ---- Base de datos (obligatorio) ----
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Panel de coordinación (obligatorio) ----
# Contraseña para entrar a /admin. Inventa una larga.
ADMIN_PASSWORD=

# ---- Correo al abogado (recomendado) ----
# resend.com → API Keys. Sin esto la plataforma funciona,
# pero nadie le avisa al abogado: tienes que mirar el panel.
RESEND_API_KEY=
EMAIL_REMITENTE="Puente Legal <casos@tudominio.org>"
EMAIL_COORDINACION=coordinacion@tudominio.org

# ---- Formulario de abogados (recomendado) ----
NEXT_PUBLIC_TALLY_URL=https://tally.so/r/xxxxxx
# Tally → Integrations → Webhooks → Signing secret
TALLY_SIGNING_SECRET=

# ---- Textos legales ----
NEXT_PUBLIC_ORGANIZACION="Legal Hackers Bogotá"
NEXT_PUBLIC_EMAIL_CONTACTO=datos@tudominio.org
